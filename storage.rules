rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profiles/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName.matches(request.auth.uid + '\\.jpg');
    }
    match /prescriptions/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}